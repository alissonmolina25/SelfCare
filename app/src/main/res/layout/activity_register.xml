<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF9F6"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="28dp"
        android:paddingTop="25dp"
        android:paddingRight="28dp"
        android:paddingBottom="35dp">

        <TextView
            android:id="@+id/btnVolver"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="&lt;"
            android:textColor="#35445A"
            android:textSize="30sp" />

        <ImageView
            android:id="@+id/imgLogoRegistro"
            android:layout_width="130dp"
            android:layout_height="130dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="5dp"
            android:contentDescription="Logo SelfCare"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_selfcare" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center"
            android:text="Crea tu cuenta"
            android:textColor="#35445A"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:gravity="center"
            android:text="Comienza hoy a cuidar de ti"
            android:textColor="#7D8B73"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/etNombre"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="35dp"
            android:background="@drawable/input_background"
            android:hint="Nombre completo"
            android:inputType="textPersonName"
            android:paddingLeft="18dp"
            android:paddingRight="18dp"
            android:textColor="#35445A"
            android:textColorHint="#8FA9C4"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/etCorreoRegistro"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/input_background"
            android:hint="Correo electrónico"
            android:inputType="textEmailAddress"
            android:paddingLeft="18dp"
            android:paddingRight="18dp"
            android:textColor="#35445A"
            android:textColorHint="#8FA9C4"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/etContrasenaRegistro"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/input_background"
            android:hint="Contraseña"
            android:inputType="textPassword"
            android:paddingLeft="18dp"
            android:paddingRight="18dp"
            android:textColor="#35445A"
            android:textColorHint="#8FA9C4"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/etConfirmarContrasena"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/input_background"
            android:hint="Confirmar contraseña"
            android:inputType="textPassword"
            android:paddingLeft="18dp"
            android:paddingRight="18dp"
            android:textColor="#35445A"
            android:textColorHint="#8FA9C4"
            android:textSize="15sp" />

        <CheckBox
            android:id="@+id/checkTerminos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Acepto los términos y condiciones"
            android:textColor="#35445A"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnCrearCuenta"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="22dp"
            android:backgroundTint="#7D8B73"
            android:text="Crear cuenta"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/txtIniciarSesion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:gravity="center"
            android:text="¿Ya tienes una cuenta? Inicia sesión"
            android:textColor="#35445A"
            android:textSize="14sp" />

    </LinearLayout>

</ScrollView>

