<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#AABBAE"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mis hábitos"
        android:textColor="#293E33"
        android:textSize="28sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="30dp"
        android:layout_marginBottom="12dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pequeños pasos para cuidar de ti cada día."
        android:textColor="#293E33"
        android:textSize="16sp"
        android:gravity="center"
        android:layout_marginBottom="30dp"/>

    <EditText
        android:id="@+id/etNuevoHabito"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Escribe un nuevo hábito"
        android:textColor="#293E33"
        android:textColorHint="#5D7062"
        android:inputType="textCapSentences"
        android:singleLine="true"
        android:padding="14dp"
        android:backgroundTint="#496653"/>

    <Button
        android:id="@+id/btnAgregarHabito"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Agregar hábito"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:backgroundTint="#496653"
        android:layout_marginTop="18dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mis hábitos diarios"
        android:textColor="#293E33"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginTop="35dp"
        android:layout_marginBottom="15dp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/contenedorHabitos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>

    </ScrollView>

    <Button
        android:id="@+id/btnVolver"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Volver al inicio"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:backgroundTint="#496653"
        android:layout_marginTop="12dp"/>

</LinearLayout>
