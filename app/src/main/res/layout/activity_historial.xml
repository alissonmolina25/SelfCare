<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#AABBAE"
    android:padding="25dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SelfCare"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#293E33"
        android:layout_marginTop="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mi diario personal"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#293E33"
        android:layout_marginTop="32dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Consulta tus registros anteriores."
        android:textSize="15sp"
        android:textColor="#354D3E"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="28dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#819A88" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mis registros"
        android:textSize="19sp"
        android:textStyle="bold"
        android:textColor="#293E33"
        android:layout_marginTop="23dp"
        android:layout_marginBottom="16dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/contenedorHistorial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtHistorial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Todavía no tienes registros guardados."
                android:textSize="16sp"
                android:textColor="#293E33"
                android:paddingTop="16dp"
                android:paddingBottom="16dp" />

        </LinearLayout>

    </ScrollView>

    <Button
        android:id="@+id/btnVolver"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="16dp"
        android:text="Volver al inicio"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#496653" />

</LinearLayout>
