<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#AABBAE"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="28dp">

        <androidx.cardview.widget.CardView
            android:layout_width="95dp"
            android:layout_height="95dp"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="48dp"
            app:cardElevation="0dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/logo_selfcare"
                android:scaleType="centerCrop"
                android:contentDescription="Logo de SelfCare" />

        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SelfCare"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#293E33"
            android:layout_marginTop="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Crear cuenta"
            android:textSize="25sp"
            android:textStyle="bold"
            android:textColor="#293E33"
            android:layout_marginTop="26dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nombre completo"
            android:textSize="15sp"
            android:textColor="#293E33"
            android:layout_marginTop="20dp" />

        <EditText
            android:id="@+id/etNombre"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Ingresa tu nombre"
            android:inputType="textPersonName"
            android:singleLine="true"
            android:textSize="16sp"
            android:textColor="#293E33"
            android:textColorHint="#66796D"
            android:backgroundTint="#496653" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Correo electrónico"
            android:textSize="15sp"
            android:textColor="#293E33"
            android:layout_marginTop="18dp" />

        <EditText
            android:id="@+id/etCorreoRegistro"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Ingresa tu correo"
            android:inputType="textEmailAddress"
            android:singleLine="true"
            android:textSize="16sp"
            android:textColor="#293E33"
            android:textColorHint="#66796D"
            android:backgroundTint="#496653" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Contraseña"
            android:textSize="15sp"
            android:textColor="#293E33"
            android:layout_marginTop="18dp" />

        <EditText
            android:id="@+id/etContrasenaRegistro"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Crea una contraseña"
            android:inputType="textPassword"
            android:singleLine="true"
            android:textSize="16sp"
            android:textColor="#293E33"
            android:textColorHint="#66796D"
            android:backgroundTint="#496653" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Confirmar contraseña"
            android:textSize="15sp"
            android:textColor="#293E33"
            android:layout_marginTop="18dp" />

        <EditText
            android:id="@+id/etConfirmarContrasena"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Repite tu contraseña"
            android:inputType="textPassword"
            android:singleLine="true"
            android:textSize="16sp"
            android:textColor="#293E33"
            android:textColorHint="#66796D"
            android:backgroundTint="#496653" />

        <Button
            android:id="@+id/btnRegistrarme"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="28dp"
            android:text="Registrarme"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#496653" />

        <Button
            android:id="@+id/btnVolverLogin"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="20dp"
            android:text="Ya tengo una cuenta"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textColor="#293E33"
            android:backgroundTint="#DDE5DC" />

    </LinearLayout>
</ScrollView>
