<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#AABBAE"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="28dp">

        <androidx.cardview.widget.CardView
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_marginTop="50dp"
            app:cardCornerRadius="55dp"
            app:cardElevation="0dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/logo_selfcare"
                android:scaleType="centerCrop"
                android:contentDescription="Logo de SelfCare" />

        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SelfCare"
            android:textSize="25sp"
            android:textStyle="bold"
            android:textColor="#293E33"
            android:layout_marginTop="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Iniciar sesión"
            android:textSize="25sp"
            android:textStyle="bold"
            android:textColor="#293E33"
            android:layout_marginTop="35dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Correo electrónico"
            android:textSize="15sp"
            android:textColor="#293E33"
            android:layout_marginTop="25dp" />

        <EditText
            android:id="@+id/etCorreo"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Ingresa tu correo"
            android:inputType="textEmailAddress"
            android:singleLine="true"
            android:textSize="16sp"
            android:textColor="#293E33"
            android:textColorHint="#66796D"
            android:backgroundTint="#496653" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Contraseña"
            android:textSize="15sp"
            android:textColor="#293E33"
            android:layout_marginTop="22dp" />

        <EditText
            android:id="@+id/etContrasena"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Ingresa tu contraseña"
            android:inputType="textPassword"
            android:singleLine="true"
            android:textSize="16sp"
            android:textColor="#293E33"
            android:textColorHint="#66796D"
            android:backgroundTint="#496653" />

        <Button
            android:id="@+id/btnIniciarSesion"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="35dp"
            android:text="Iniciar sesión"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#496653" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¿Todavía no tienes una cuenta?"
            android:textSize="15sp"
            android:textColor="#354D3E"
            android:layout_marginTop="28dp" />

        <Button
            android:id="@+id/btnCrearCuenta"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:text="Crear cuenta"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textColor="#293E33"
            android:backgroundTint="#DDE5DC" />

    </LinearLayout>
</ScrollView>
