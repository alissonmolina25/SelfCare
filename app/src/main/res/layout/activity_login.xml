<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FAF9F6">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingBottom="30dp">

        <!-- Regresar -->
        <TextView
            android:id="@+id/btnVolver"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:layout_marginTop="25dp"
            android:gravity="center"
            android:text="Atrás"
            android:textColor="#35445A"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Título -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:gravity="center"
            android:text="¡Bienvenida de nuevo!"
            android:textColor="#35445A"
            android:textSize="25sp"
            android:textStyle="bold" />

        <!-- Subtítulo -->

        <!-- Correo electrónico -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Tu bienestar también importa"
            android:textColor="#8FA9C4"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/etCorreo"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="45dp"
            android:background="@drawable/input_background"
            android:hint="Correo electrónico"
            android:inputType="textEmailAddress"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:textColor="#35445A"
            android:textColorHint="#8FA9C4"
            android:textSize="15sp" />

        <!-- Contraseña -->
        <EditText
            android:id="@+id/etContrasena"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="15dp"
            android:background="@drawable/input_background"
            android:hint="Contraseña"
            android:inputType="textPassword"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:textColor="#35445A"
            android:textColorHint="#8FA9C4"
            android:textSize="15sp" />

        <!-- Recordarme -->
        <CheckBox
            android:id="@+id/checkRecordarme"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:buttonTint="#7D8B73"
            android:text="Recordarme"
            android:textColor="#35445A"
            android:textSize="14sp" />

        <!-- Recuperar contraseña -->
        <TextView
            android:id="@+id/txtOlvidaste"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="¿Olvidaste tu contraseña?"
            android:textColor="#35445A"
            android:textSize="13sp" />

        <!-- Botón verde -->
        <Button
            android:id="@+id/btnIniciarSesion"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="25dp"
            android:backgroundTint="#7D8B73"
            android:text="Iniciar sesión"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Separador -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:text="────────   o continúa con   ────────"
            android:textColor="#8FA9C4"
            android:textSize="12sp" />

        <!-- Crear cuenta -->
        <TextView
            android:id="@+id/txtRegistrarse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:gravity="center"
            android:text="¿No tienes una cuenta? Regístrate"
            android:textColor="#35445A"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>